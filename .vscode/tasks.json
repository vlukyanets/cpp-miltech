{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure and build",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "clang-format: reformat project",
      "type": "shell",
      "command": "find homework_06 \\( -name '*.cpp' -o -name '*.hpp' -o -name '*.h' \\) -print | xargs clang-format -i",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "clang-tidy: analyze project",
      "type": "shell",
      "command": "run-clang-tidy -p build/debug 'homework_06/(src|include|tests)/.*\\.(cpp|h|hpp)$'",
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CMake: clean build directory",
      "type": "shell",
      "command": "rm -rf build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
